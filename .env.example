# PostgreSQL settings used by Docker Compose.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# PostgreSQL connection used by Drizzle Kit when it runs on your host machine.
# The app container builds its own connection string using the settings above.
DATABASE_URL=postgres://${POSTGRES_USER:-postgres}:${POSTGRES_PASSWORD:-admin}@db:5432/${POSTGRES_DB:-url_shortener}

# Use a long random value in real environments.
JWT_SECRET=replace-with-a-long-random-secret

# Optional application settings.
PORT=3000
NODE_ENV=development

